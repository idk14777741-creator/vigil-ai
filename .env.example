# VIGIL AI — environment template (live mode)
# Copy to `.env` and fill in. NEVER commit `.env`. Everything is optional:
# with none of these set, the app runs in demo mode exactly as now.

# ---- App mode ----
# VIGIL_MODE=demo            # "demo" (default) or "live"
# VIGIL_HOST=127.0.0.1
# VIGIL_PORT=8787

# ---- Category 1: Supabase (database, auth, storage) ----
# From Supabase dashboard → Settings → API.
# SUPABASE_URL=https://YOURPROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...            # client-safe (RLS protects it)
# SUPABASE_SERVICE_KEY=eyJ...         # SERVER ONLY — never expose to the browser

# ---- Category 2: LLM provider (VIGIL AI Assistant) ----
# VIGIL_AI_PROVIDER=openai            # mock (default) | openai | anthropic
# VIGIL_AI_API_KEY=sk-...             # SERVER ONLY
# VIGIL_AI_MODEL=gpt-4o-mini          # or claude-3-5-haiku-latest etc.

# ---- Category 3: Wearable provider ----
# VIGIL_WEARABLE_PROVIDER=simulated   # simulated (default) | vendor name
# VIGIL_WEARABLE_API_KEY=...          # SERVER ONLY

# ---- Category 4: Media storage ----
# VIGIL_MEDIA_STORAGE=local           # local (default) | supabase

# ---- Category 5: Email (password resets) ----
# VIGIL_SMTP_HOST=smtp.fastmail.com
# VIGIL_SMTP_PORT=587
# VIGIL_SMTP_USER=you@example.com
# VIGIL_SMTP_PASSWORD=...             # SERVER ONLY
# VIGIL_SMTP_FROM=VIGIL AI <noreply@example.com>
